<?xml version="1.0" encoding="utf-8"?>
<!-- The Ravelry key is device-only: it is never included in cloud backup or device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="ravelry_credentials.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="ravelry_credentials.xml" />
    </device-transfer>
</data-extraction-rules>
