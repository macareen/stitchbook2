<?xml version="1.0" encoding="utf-8"?>
<!-- A heart-shaped rose yarn ball on two crossed wooden needles, kept inside the adaptive icon's safe zone. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Drawn on a 120-unit grid and scaled about its centre so a round mask never clips the needle tips. -->
    <group
        android:pivotX="60"
        android:pivotY="60"
        android:scaleX="0.6"
        android:scaleY="0.6"
        android:translateX="-6"
        android:translateY="-6">

        <!-- Needles, behind the ball -->
        <path
            android:pathData="M22,104 L96,18"
            android:strokeColor="#C9A27E"
            android:strokeWidth="5"
            android:strokeLineCap="round" />
        <path
            android:pathData="M98,104 L24,18"
            android:strokeColor="#C9A27E"
            android:strokeWidth="5"
            android:strokeLineCap="round" />
        <path
            android:fillColor="#B4485A"
            android:pathData="M91,18 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0z" />
        <path
            android:fillColor="#B4485A"
            android:pathData="M19,18 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0z" />

        <!-- Heart ball -->
        <path
            android:fillColor="#EE8F94"
            android:pathData="M60,98 C30,78 18,62 18,46 C18,32 29,22 42,22 C51,22 57,27 60,33 C63,27 69,22 78,22 C91,22 102,32 102,46 C102,62 90,78 60,98Z" />

        <!-- Wrapped strands, clipped to the heart -->
        <group>
            <clip-path android:pathData="M60,98 C30,78 18,62 18,46 C18,32 29,22 42,22 C51,22 57,27 60,33 C63,27 69,22 78,22 C91,22 102,32 102,46 C102,62 90,78 60,98Z" />
            <path android:pathData="M18,40 Q60,60 104,36" android:strokeColor="#C9606A" android:strokeWidth="2.6" android:strokeLineCap="round" />
            <path android:pathData="M16,54 Q60,74 106,50" android:strokeColor="#C9606A" android:strokeWidth="2.6" android:strokeLineCap="round" />
            <path android:pathData="M22,68 Q60,88 100,64" android:strokeColor="#C9606A" android:strokeWidth="2.6" android:strokeLineCap="round" />
            <path android:pathData="M46,18 Q68,56 50,102" android:strokeColor="#C9606A" android:strokeWidth="2.6" android:strokeLineCap="round" />
            <path android:pathData="M68,18 Q88,56 70,102" android:strokeColor="#C9606A" android:strokeWidth="2.6" android:strokeLineCap="round" />
        </group>
    </group>
</vector>
